# GitHub OAuth App Client ID (https://github.com/settings/developers)
GITHUB_CLIENT_ID=

# Client Secret — required for the web authorize flow (Authorize button on github.com).
# Stays server-side only in .env.local / Route Handlers. Never expose to the browser.
GITHUB_CLIENT_SECRET=

# Must match a Redirect URI registered on the OAuth App exactly.
GITHUB_REDIRECT_URI=http://localhost:3000/api/github/oauth/callback

# OAuth scopes. Default is public-only.
# Private repos need "repo" — a broader grant; use only if you accept that trade-off.
GITHUB_OAUTH_SCOPES=read:user public_repo

# 32+ char secret used to encrypt the GitHub access token cookie (AES-GCM).
# Generate with: openssl rand -base64 32
SESSION_SECRET=
